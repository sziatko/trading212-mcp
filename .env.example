TRADING212_API_KEY=your-live-api-key-here
TRADING212_DEMO_API_KEY=your-demo-api-key-here
TRADING212_USE_LIVE=false

# Tool category toggles (default: true)
ENABLE_ACCOUNT_TOOLS=true
ENABLE_POSITIONS_TOOLS=true
ENABLE_ORDERS_TOOLS=true
ENABLE_HISTORY_TOOLS=true
ENABLE_PIES_TOOLS=true
ENABLE_METADATA_TOOLS=true

# Write tools (default: false for both).
# On a remote/HTTP deployment, leave BOTH of these false: a public HTTPS
# endpoint has a wider attack surface than a local stdio process.
ENABLE_ORDER_WRITE_TOOLS=false
ENABLE_PIE_WRITE_TOOLS=false

# --- Transport ---------------------------------------------------------------
# Unset (or anything other than "http") => stdio transport, for Claude Desktop
# running the server locally as a subprocess. This is the default.
# TRANSPORT=http => Streamable HTTP transport, for remote deployment (see the
# "Remote deployment (Render)" section in the README).
# TRANSPORT=http

# HTTP transport only. Port to listen on (0.0.0.0). Render sets this
# automatically; 3000 is the local fallback.
# PORT=3000

# HTTP transport only. REQUIRED when TRANSPORT=http — the server refuses to
# start without it. Clients must send `Authorization: Bearer <this value>` on
# every request to /mcp. Generate one with:  openssl rand -hex 32
# MCP_AUTH_TOKEN=
